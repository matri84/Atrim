     /** مقایسه‌ی امن (زمان‌ثابت) دو مقدار، بدون type juggling */
     private static function sameAs(mixed $other, string $str): bool
     {
          return is_scalar($other) && !is_bool($other) && hash_equals((string) $other, $str);
     }

     /**
      * اجرای regex با کنترل خطا.
      * true/false = نتیجه‌ی تطبیق، null = خطا (الگوی نامعتبر یا ورودی خیلی بلند → قانون رد می‌شود)
      */
     private static function matches(string $pattern, string $str): ?bool
     {
          if (strlen($str) > self::REGEX_MAX_LENGTH) {
               return null;
          }
          // الگو را قبل از استفاده تست می‌کنیم تا Warning تولید نشود
          if (@preg_match($pattern, '') === false) {
               throw new InvalidArgumentException('Invalid regex pattern in rule.');
          }

          $result = preg_match($pattern, $str);

          return $result === false ? null : $result === 1;
     }

     private static function isStrongPassword(string $password, int $min): bool
     {
          $len = mb_strlen($password);

          return $len >= $min
               && $len <= self::PASSWORD_MAX_LENGTH
               && preg_match('/[a-z]/', $password) === 1
               && preg_match('/[A-Z]/', $password) === 1
               && preg_match('/[0-9]/', $password) === 1
               && preg_match('/[^\p{L}\p{N}\s]/u', $password) === 1;
     }

     private static function isNationalCode(string $code): bool
     {
