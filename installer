               'ip'         => filter_var($str, FILTER_VALIDATE_IP) !== false,
               'date'       => self::isDate($str),
               'digits'     => ctype_digit(self::latinDigits($str)) && strlen(self::latinDigits($str)) === (int) $params[0],
               'same'       => self::sameAs($data[$params[0]] ?? null, $str),
               'confirmed'  => self::sameAs($data[$field . '_confirmation'] ?? null, $str),
               'different'  => !self::sameAs($data[$params[0]] ?? null, $str),
               'in'         => in_array($str, $params, true),
               'not_in'     => !in_array($str, $params, true),
               'regex'      => self::matches($params[0], $str) === true,
               'not_regex'  => self::matches($params[0], $str) === false,
               'english'    => preg_match('/^[A-Za-z ]+\z/', $str) === 1,
               'persian'    => preg_match('/^[\x{0621}-\x{063A}\x{0641}-\x{064A}\x{067E}\x{0686}\x{0698}\x{06A9}\x{06AF}\x{06CC}\x{200C} ]+\z/u', $str) === 1,
