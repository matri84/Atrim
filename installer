<?php

function Router(): void{
    global $routes, $conf;

    $uri = parse_url($_SERVER["REQUEST_URI"] ?? "/", PHP_URL_PATH);

    if (!is_string($uri)) {
        $uri = "/";
    }

    $basePath = parse_url($conf["APP_URL"] ?? "", PHP_URL_PATH) ?? "";
    $basePath = rtrim($basePath, "/");

    if ($basePath !== "") {

        if ($uri === $basePath) {
            $uri = "/";
        } elseif (str_starts_with($uri, $basePath . "/")) {
            $uri = substr($uri, strlen($basePath));
        }
    }

    $uri = "/" . trim($uri, "/");

    if (!is_array($routes ?? null)) {
        $routes = [];
    }

    foreach ($routes as $route => $page) {

        if (!is_string($route) || !is_string($page)) {
            continue;
        }

        $params = [];

        $route = "/" . trim($route, "/");

        $pattern = preg_replace_callback(
            '/:([a-zA-Z_][a-zA-Z0-9_]*)/',
            function ($matches) use (&$params) {

                $params[] = $matches[1];

                return "\x1A" . (count($params) - 1) . "\x1A";
            },
            $route
        );

        $pattern = preg_quote($pattern, "#");

        foreach ($params as $index => $param) {

            $pattern = str_replace(
                preg_quote("\x1A" . $index . "\x1A", "#"),
                "([^/]+)",
                $pattern
            );
        }

        $pattern = "#^" . $pattern . "$#D";

        // Match route
        if (!preg_match($pattern, $uri, $matches)) {
            continue;
        }

        array_shift($matches);

        // Prepare route parameters
        $routeParams = [];

        foreach ($params as $index => $param) {
            $routeParams[$param] = rawurldecode($matches[$index]);
        }

        // Resolve pages directory
        $pagesDir = realpath(__DIR__ . "/../../Pages");

        if ($pagesDir === false) {
            http_response_code(500);
            exit("Pages directory not found.");
        }

        // Resolve requested page
        $file = realpath(
            $pagesDir . DIRECTORY_SEPARATOR . $page . ".atrim.php"
        );

        // Validate page path
        if (
            $file === false ||
            !str_starts_with(
                $file,
                $pagesDir . DIRECTORY_SEPARATOR
            ) ||
            !is_file($file)
        ) {
            http_response_code(500);
            exit("Page file not found.");
        }

        // Extract route parameters
        extract($routeParams, EXTR_SKIP);

        // Load page
        require $file;

        return;
    }

    // 404 Not Found
    http_response_code(404);

    $notPage = __DIR__ . "/../../Pages/404.atrim.php";

    if (is_file($notPage)) {
        require $notPage;
    } else {
        echo "This page was not found.";
    }
}

function getHeader(): void{
    $file = __DIR__ . "/../../Pages/header.php";

    if (is_file($file)) {
        require $file;
    }
}

function getFooter(): void{
    $file = __DIR__ . "/../../Pages/footer.php";

    if (is_file($file)) {
