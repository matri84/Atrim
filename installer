    }
}

function url(string $path = "/"): string{
    global $conf;

    $baseUrl = rtrim($conf["APP_URL"] ?? "", "/");

    return $baseUrl . "/" . ltrim($path, "/");
}

function Assets(string $path): void{
    echo e(url("/Assets/" . ltrim($path, "/")));
}

function go(string $path = "/"): void{
    header("Location: " . url($path));
    exit;
}

function isLogin(): bool{
    return \Core\Classes\SH::has("logged_in");
}

function mustLogin(string $loginPath = "/login"): void{
    if (!isLogin()) {
        go($loginPath);
    }
}

function logOut(): bool{
    if (!isLogin()) {
        return false;
    }

    \Core\Classes\SH::delete("logged_in");
    \Core\Classes\SH::delete("user");

    go("/");

    return true;
}

function J2A(string $json = ""): mixed{
    if ($json === "") {
        return false;
    }

    $result = json_decode($json);

    if (json_last_error() !== JSON_ERROR_NONE) {
        return false;
    }

    return $result;
}

function A2J(mixed $value): string|false{
    return json_encode(
        $value,
        JSON_UNESCAPED_UNICODE |
        JSON_UNESCAPED_SLASHES |
        JSON_INVALID_UTF8_SUBSTITUTE
    );
}

function e(mixed $value): string{
    if ($value === null || is_bool($value)) {
        return "";
    }

    if (
        is_array($value) ||
        (is_object($value) && !$value instanceof Stringable)
    ) {
        return "";
    }

    if (!is_scalar($value) && !$value instanceof Stringable) {
        return "";
    }

    return htmlspecialchars(
        (string) $value,
        ENT_QUOTES | ENT_SUBSTITUTE,
        "UTF-8"
    );
}

function old(string $key,mixed $default = "",string $method = "POST"): mixed {
    $source = match (strtoupper($method)) {
        "GET" => $_GET,
        "POST" => $_POST,
        "REQUEST" => $_REQUEST,
        default => []
    };

    return $source[$key] ?? $default;
}

function input(?string $key = null,mixed $default = null,string $method = "POST"): mixed {
    $source = match (strtoupper($method)) {
        "GET"     => $_GET,
        "POST"    => $_POST,
        "REQUEST" => $_REQUEST,
        default   => []
    };

    if ($key === null) {
        return $source;
    }

    return $source[$key] ?? $default;
}
