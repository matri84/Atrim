     public static function paginate(string $table, int $page = 1, array $where = [], array $columns = ['*'])
     {
          global $conf;
          $names = array_merge([$table], array_keys($where), $columns === ['*'] ? [] : $columns);
          foreach ($names as $name) {
               if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', (string) $name)) {
                    throw new InvalidArgumentException("نام نامعتبر: {$name}");
               }
          }

          $page = max(1, $page);
          $perPage = max(1, min(100, $conf['POST_PERPAGE']));
          $offset = ($page - 1) * $perPage;

          $cols = ($columns === ['*'] || !$columns) ? '*' : '`' . implode('`, `', $columns) . '`';

          $conds = [];
          $params = [];

          foreach ($where as $field => $value) {
               if ($value === null) {
                    $conds[] = "`$field` IS NULL";
               } else {
                    $conds[] = "`$field` = ?";
                    $params[] = $value;
               }
          }
          $whereSql = $conds ? ' WHERE ' . implode(' AND ', $conds) : '';

          $sql = "SELECT COUNT(*) FROM `$table`" . $whereSql;
          $stmt = self::connection()->prepare($sql);
          $stmt->execute($params);
          $total = (int) $stmt->fetchColumn();

          $stmt = self::connection()->prepare("SELECT $cols FROM `$table`$whereSql LIMIT  $perPage OFFSET $offset");
          $stmt->execute($params);

          return [
               'data' => $stmt->fetchAll(),
               'meta' => [
                    'total' => $total,
                    'per_page' => $perPage,
                    'current_page' => $page,
                    'last_page' => (int) ceil($total / $perPage),
               ]
          ];
     }

     public static function search(
          string $table,
          string $keyword,
          array $columns,
          array $where = [],
          int $limit = 10
     ) {

          if (!$columns) {
               throw new InvalidArgumentException("ستون‌های جست‌وجو مشخص نشده‌اند");
          }

          $names = array_merge(
               [$table],
               $columns,
               array_keys($where)
          );

          foreach ($names as $name) {
               if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', (string) $name)) {
                    throw new InvalidArgumentException("نام نامعتبر: {$name}");
               }
          }

          $limit = max(1, min(100, $limit));
          $keyword = trim($keyword);

          if ($keyword === '') {
               return [];
          }

          $conditions = [];
          $params = [];

          foreach ($columns as $column) {
               $conditions[] = "`$column` LIKE ?";
               $params[] = "%$keyword%";
          }

          $sql = "SELECT * FROM `$table` WHERE (" .
               implode(' OR ', $conditions) . ")";

          foreach ($where as $field => $value) {
               if ($value === null) {
                    $sql .= " AND `$field` IS NULL";
               } else {
                    $sql .= " AND `$field` = ?";
                    $params[] = $value;
               }
          }

          $sql .= " LIMIT $limit";

          $stmt = self::connection()->prepare($sql);
          $stmt->execute($params);

          return $stmt->fetchAll();
     }

