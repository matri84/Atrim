          $sum = 0;
          for ($i = 0; $i < 9; $i++) {
               $sum += (int) $code[$i] * (10 - $i);
          }
          $remain = $sum % 11;

          return (int) $code[9] === ($remain < 2 ? $remain : 11 - $remain);
     }

