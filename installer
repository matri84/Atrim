<?php

namespace Core\Classes;

use PDO;
use InvalidArgumentException;
use LogicException;

class DB
{
     private static ?PDO $conn = null;

     public static function setConnection(PDO $conn): void
     {
          if (self::$conn !== null) {
               throw new LogicException("اتصال دیتابیس قبلاً تنظیم شده است.");
          }

          self::$conn = $conn;
     }

     private static function connection()
     {
          if (self::$conn === null) {
               throw new LogicException("اتصال دیتابیس تنظیم نشده است.");
          }

          return self::$conn;
     }

     public static function insert(string $table, array $data)
     {
          if (!$data) throw new InvalidArgumentException("داده ای برای ورود وجود ندارد");

          foreach (array_merge([$table], array_keys($data)) as $name) {
               if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', (string) $name)) {
                    throw new InvalidArgumentException("نام نامعتبر: {$name}");
               }
          }

          $cols = '`' . implode('`, `', array_keys($data)) . '`';
          $marks = implode(', ', array_fill(0, count($data), '?'));

          $stmt = self::connection()->prepare("INSERT INTO `$table` ($cols) VALUES ($marks)");

          $stmt->execute(array_values($data)) ? true : false;
     }

     public static function get(string $table, bool $single = false, array $where = [], array $columns = ['*'])
     {
          $names = array_merge([$table], array_keys($where), $columns === ['*'] ? [] : $columns);
          foreach ($names as $name) {
               if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', (string) $name)) {
                    throw new InvalidArgumentException("نام نامعتبر: {$name}");
               }
          }

          $cols = ($columns === ['*'] || !$columns) ? '*' : '`' . implode('`, `', $columns) . '`';
          $sql = "SELECT $cols FROM `$table`";

          $conds = [];
          $params = [];

          foreach ($where as $field => $value) {
               if ($value === null) {
                    $conds[] = "`$field` IS NULL";
               } else {
                    $conds[] = "`$field` = ?";
                    $params[] = $value;
               }
          }

          if ($conds) $sql .= ' WHERE ' . implode(' AND ', $conds);
          if ($single) $sql .= ' LIMIT 1';

          $stmt = self::connection()->prepare($sql);
          $stmt->execute($params);

          return $single ? ($stmt->fetch() ?: null) : $stmt->fetchAll();
     }

     public static function update(string $table, array $where, array $data)
     {
          if (!$data) throw new InvalidArgumentException("داده‌ای برای ویرایش وجود ندارد");
          if (!$where) throw new InvalidArgumentException("عملیات آپدیت بدون شرط مجاز نیست");

          foreach (array_merge([$table], array_keys($data), array_keys($where)) as $name) {
               if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', (string) $name)) {
                    throw new InvalidArgumentException("نام نامعتبر: {$name}");
               }
          }

          $set = [];
          $params = [];
          foreach ($data as $field => $value) {
               $set[] = "`$field` = ?";
               $params[] = $value;
          }

          $conds = [];
          foreach ($where as $field => $value) {
               if ($value === null) {
                    $conds[] = "`$field` IS NULL";
               } else {
                    $conds[] = "`$field` = ?";
                    $params[] = $value;
               }
          }

          $sql = "UPDATE `$table` SET " . implode(', ', $set) . ' WHERE ' . implode(' AND ', $conds);
          $stmt = self::connection()->prepare($sql);
          if ($stmt->execute($params)) {
               return true;
          } else {
               return false;
          }
     }

