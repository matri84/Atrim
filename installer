     /**
      * @return list<array{0: string, 1: list<string>}>
      */
     private static function parseRules(string $field, mixed $ruleSet): array
     {
          $list = is_string($ruleSet) ? explode('|', $ruleSet) : $ruleSet;
          if (!is_array($list)) {
               throw new InvalidArgumentException("Rules of '{$field}' must be a string or an array.");
          }

          $parsed = [];
          foreach ($list as $item) {
               if (!is_string($item) || trim($item) === '') {
                    throw new InvalidArgumentException("Invalid rule for '{$field}'.");
               }

               [$name, $param] = array_pad(explode(':', trim($item), 2), 2, null);
               $name = strtolower(trim($name));

               if (!array_key_exists($name, self::RULES)) {
                    throw new InvalidArgumentException("Unknown rule '{$name}' for '{$field}'.");
               }

               // الگوی regex ممکن است کاما داشته باشد، پس تکه‌تکه نمی‌شود
               $params = $param === null
                    ? []
                    : (in_array($name, ['regex', 'not_regex'], true) ? [$param] : array_map('trim', explode(',', $param)));

               if (count($params) < self::RULES[$name]) {
                    throw new InvalidArgumentException("Rule '{$name}' for '{$field}' needs " . self::RULES[$name] . ' parameter(s).');
               }
               if (in_array($name, ['min', 'max', 'between', 'size', 'digits'], true)) {
                    foreach ($params as $p) {
                         if (!is_numeric($p)) {
                              throw new InvalidArgumentException("Rule '{$name}' for '{$field}' needs numeric parameters.");
                         }
                    }
               }
               if ($name === 'password' && $params !== [] && !ctype_digit($params[0])) {
                    throw new InvalidArgumentException("Rule 'password' for '{$field}' needs a numeric min length.");
               }

               $parsed[] = [$name, $params];
          }

          return $parsed;
     }

     /**
      * @param list<string>         $params
      * @param array<string, mixed> $data
      */
     private static function check(string $rule, mixed $value, array $params, array $data, string $field, string $type): bool
     {
          if ($rule === 'array') {
               return is_array($value);
          }

          $isSizeRule = in_array($rule, ['min', 'max', 'between', 'size'], true);
          if (is_array($value)) {
               if (!$isSizeRule) {
                    return false;
               }
               $str = '';
          } else {
               $str = is_bool($value) ? ($value ? '1' : '0') : (string) $value;
          }

          if ($isSizeRule) {
               $size = match ($type) {
                    'array'   => count($value),
                    'numeric' => preg_match('/^-?\d+(\.\d+)?\z/', self::latinDigits($str)) === 1
                         ? (float) self::latinDigits($str)
                         : null,
                    default   => mb_strlen($str),
               };
               if ($size === null) {
                    return false;
               }

               return match ($rule) {
                    'min'     => $size >= (float) $params[0],
                    'max'     => $size <= (float) $params[0],
                    'between' => $size >= (float) $params[0] && $size <= (float) $params[1],
                    default   => $size == (float) $params[0],
               };
          }

          return match ($rule) {
               'string'     => is_string($value),
               'numeric'    => preg_match('/^-?\d+(\.\d+)?\z/', self::latinDigits($str)) === 1,
               'integer'    => preg_match('/^-?\d+\z/', self::latinDigits($str)) === 1
                    && filter_var(self::latinDigits($str), FILTER_VALIDATE_INT) !== false,
               'boolean'    => in_array($value, [true, false, 0, 1, '0', '1'], true),
               'email'      => strlen($str) <= 254 && filter_var($str, FILTER_VALIDATE_EMAIL) !== false,
               'url'        => preg_match('/^https?:\/\/[^\s]+\z/i', $str) === 1
