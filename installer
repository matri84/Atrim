     /**
      * اعتبارسنجی داده‌ها. در صورت موفقیت true برمی‌گرداند.
      *
      * @param array<string, mixed>        $data       داده‌های ورودی (مثلاً $_POST)
      * @param array<string, string|array> $rules      قوانین هر فیلد: 'a|b:1' یا ['a', 'b:1']
      * @param array<string, string>       $messages   پیام سفارشی: 'rule' یا 'field.rule'
      * @param array<string, string>       $attributes نام نمایشی فیلدها: ['email' => 'ایمیل']
      *
      * @throws InvalidArgumentException برای قانون ناشناخته یا پارامتر اشتباه (خطای برنامه‌نویس)
      */
     public static function validation(
          array $data,
          array $rules,
          array $messages = [],
          array $attributes = []
     ): bool {
          self::$message = [];

          $fail = static function (string $field, string $rule, array $params, string $type = 'string') use ($messages, $attributes): void {
               global $errors;
               $key = in_array($rule, ['min', 'max', 'between', 'size'], true) ? $rule . '.' . $type : $rule;
               $template = $messages[$field . '.' . $rule] ?? $messages[$rule] ?? $errors[$key];
               if (!is_string($template)) {
                    $template = $errors[$key];
               }

               $other = $params[0] ?? '';
               $text = strtr($template, [
                    ':attribute' => $attributes[$field] ?? str_replace('_', ' ', $field),
                    ':other'     => $attributes[$other] ?? $other,
                    ':min'       => $params[0] ?? ($rule === 'password' ? '8' : ''),
                    ':max'       => $rule === 'between' ? ($params[1] ?? '') : ($params[0] ?? ''),
                    ':size'      => $params[0] ?? '',
                    ':digits'    => $params[0] ?? '',
               ]);

               self::$message[$field][] = $text;
          };

          foreach ($rules as $field => $ruleSet) {
               $field = (string) $field;
               $parsed = self::parseRules($field, $ruleSet);
               $names = array_column($parsed, 0);

               $value = $data[$field] ?? null;
               $isEmpty = $value === null
                    || (is_string($value) && trim($value) === '')
                    || $value === [];

               if ($isEmpty) {
                    if (in_array('required', $names, true)) {
                         $fail($field, 'required', []);
                    }
                    continue; // فیلد خالی و غیرالزامی: بقیه قوانین اجرا نمی‌شوند
               }

               // ورودی‌های خطرناک: آرایه‌ی ناخواسته، آبجکت، UTF-8 خراب، بایت null
               if (is_array($value)) {
                    if (!in_array('array', $names, true)) {
                         $fail($field, 'invalid', []);
                         continue;
                    }
               } elseif (
                    !is_scalar($value)
                    || (is_string($value) && (!mb_check_encoding($value, 'UTF-8') || str_contains($value, "\0")))
               ) {
                    $fail($field, 'invalid', []);
                    continue;
               }

               $type = in_array('numeric', $names, true) || in_array('integer', $names, true)
                    ? 'numeric'
                    : (is_array($value) ? 'array' : 'string');
               $bail = in_array('bail', $names, true);

               foreach ($parsed as [$rule, $params]) {
                    if (in_array($rule, ['required', 'nullable', 'bail'], true)) {
