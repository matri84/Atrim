     public static function delete(string $name)
     {
          if (isset($_SESSION[$name])) {
               unset($_SESSION[$name]);
               return true;
          } else {
               return false;
          }
     }


     public static function ex(string $name, bool $login = false): bool
     {
          global $conf;

          $key = $name . '_last_activity';

          $expireTime = $login
               ? (int) $conf["LOGIN_EXPIRE_TIME"]
               : (int) $conf["EXPIRE_TIME"];

          if (!isset($_SESSION[$key])) {
               $_SESSION[$key] = time();
               return false;
          }

          if (time() - $_SESSION[$key] >= $expireTime) {
               unset($_SESSION[$name], $_SESSION[$key]);
               return true;
          }

          return false;
     }


     public static function has(string $name)
     {
          if (isset($_SESSION[$name])) {
               return true;
          } else {
               return false;
          }
     }

     public static function flash(string $name)
     {
          if (!isset($_SESSION[$name])) {
               return false;
          }

          $value = $_SESSION[$name];
          unset($_SESSION[$name]);
          return $value;
     }
