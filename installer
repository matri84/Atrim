     public static function upload(array $file, string $path = '', array $allowed = ['jpg', 'jpeg', 'png', 'webp', 'pdf'], int $maxSize = 2097152): string
     {
          global $conf;

          if (($file['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) {
               throw new InvalidArgumentException("آپلود فایل با خطا مواجه شد");
          }

          if ($file['size'] > $maxSize) {
               throw new InvalidArgumentException("حجم فایل بیشتر از حد مجاز است");
          }

          $ext = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));
          if (!in_array($ext, $allowed, true)) {
               throw new InvalidArgumentException("نوع فایل مجاز نیست");
          }

          $path = trim(str_replace('\\', '/', $path), '/');
          if ($path !== '' && !preg_match('/^[A-Za-z0-9_\-]+(\/[A-Za-z0-9_\-]+)*$/', $path)) {
               throw new InvalidArgumentException("مسیر نامعتبر است");
          }

          $root = dirname(__DIR__, 2);
          $dir  = $root . '/Assets' . ($path !== '' ? '/' . $path : '');

          if (!is_dir($dir) && !mkdir($dir, 0755, true) && !is_dir($dir)) {
               throw new \RuntimeException("ساخت پوشه مقصد ممکن نشد");
          }

          $base = pathinfo($file['name'], PATHINFO_FILENAME);
          $base = preg_replace('/[^\p{L}\p{N}_\-]+/u', '-', $base);
          $base = trim($base, '-_');
          if ($base === '') $base = 'file';
          $base = mb_substr($base, 0, 100);

          $name = $base . '.' . $ext;

          $i = 1;
          while (file_exists($dir . '/' . $name)) {
               $name = $base . '-' . $i++ . '.' . $ext;
          }

          if (!move_uploaded_file($file['tmp_name'], $dir . '/' . $name)) {
               throw new \RuntimeException("ذخیره فایل ممکن نشد");
          }

          return rtrim($conf['APP_URL'], '/') . '/Assets/' . ($path !== '' ? $path . '/' : '') . rawurlencode($name);
     }
